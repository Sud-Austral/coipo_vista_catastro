
# reglas de COIPO_ERRORES (rutas absolutas, personales)
.claude/rules/errores-*.md
data/catastro_gef_singeometria.duckdb

# Fase 0: el spike es codigo de medicion, se versiona. Sus insumos y salidas no:
# el .bin se regenera con gen_bin.py y las capturas con medir.py.
spike/datos/
spike/vendor/
spike/captura-*.png

node_modules/
dist/

# Salidas de los notebooks de analisis: se regeneran con leer_bin.py y pesan
# ~31 MB cada una. El .bin versionado ya es la fuente.
notebooks/*.parquet

# Bytecode. OJO: ETL/__pycache__/build_bin.cpython-313.pyc y
# spike/__pycache__/medir.cpython-313.pyc quedaron VERSIONADOS antes de esta
# regla; esto solo evita que se sumen mas. Sacar los dos ya trackeados es
# `git rm --cached`, y no se hace aqui porque cambia el historial de archivos
# que alguien pudo haber puesto a proposito.
__pycache__/
