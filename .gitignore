
# reglas de COIPO_ERRORES (rutas absolutas, personales)
.claude/rules/errores-*.md
data/catastro_gef_singeometria.duckdb

# Fase 0: el spike es codigo de medicion, se versiona. Sus insumos y salidas no:
# el .bin se regenera con gen_bin.py y las capturas con medir.py.
spike/datos/
spike/vendor/
spike/captura-*.png

node_modules/
dist/
# Paquetes SSR de scripts/prerender.mjs y scripts/web.mjs: se construyen y se borran en cada
# corrida. .web/ es el insumo de las tarjetas PNG (textos ya formateados), no se publica.
.prerender/
.prerender-web/
.web/

# Salidas de los notebooks de analisis: se regeneran con leer_bin.py y pesan
# ~31 MB cada una. El .bin versionado ya es la fuente.
notebooks/*.parquet

# Bytecode. OJO: ETL/__pycache__/build_bin.cpython-313.pyc y
# spike/__pycache__/medir.cpython-313.pyc quedaron VERSIONADOS antes de esta
# regla; esto solo evita que se sumen mas. Sacar los dos ya trackeados es
# `git rm --cached`, y no se hace aqui porque cambia el historial de archivos
# que alguien pudo haber puesto a proposito.
__pycache__/

# Intermedios de la verificacion del visor. Las `captura-*.png` SI se versionan
# --son la evidencia mirable de cada tanda--, pero estas dos familias no:
#   - `*-sin-capa.png` es el fotograma auxiliar con `.deck-overlay` oculto, que
#     solo existe para restarlo y medir el disco;
#   - `mutacion-*.png` las escribe `mutaciones-visor.py`, que corre con el codigo
#     ROTO a proposito: versionarlas seria versionar el defecto.
frontend/verificacion/*-sin-capa.png
frontend/verificacion/mutacion-*.png

# --- Higiene basica: dependencias, artefactos de build y secretos ---
.env
.env.local
.env.*.local
